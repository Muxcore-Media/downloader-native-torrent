# MUXCORE_MODULE_ID=downloader-native-torrent
# DOWNLOADER_GRPC_ADDR=:9461
# DOWNLOAD_STORAGE=auto
# DOWNLOAD_DIR=/var/lib/downloader-native-torrent/downloads
# DOWNLOADER_ENGINE=fake
# DOWNLOADER_PUBLIC_METAINFO_CACHE=false
# TORRENT_LISTEN_PORT=6881
# TORRENT_FILE_PRIORITY=all
# TORRENT_ENABLE_DHT=true
# TORRENT_ENABLE_PEX=true
# SEED_RATIO=1.0
# SEED_MINUTES=60
# WG_CONF=
# WG_KILL_SWITCH=false
# WG_KILL_SWITCH_ALLOW=false
# NAT_PMP_PORT=0  # unused for Proton mapping; fallback listen only if TORRENT_LISTEN_PORT unset
# MUXCORE_GRPC_ADDR=
# MUXCORE_INSECURE_DISABLE_TLS=false
